{# MODAL #}
{% props allowSmallWidth=false, closeButton=false, padding='p-5', fixedTop=true, modalWidth="" %}

{# PREVENT CACHE - right before Turbo takes its snapshot, it dispatches an event called turbo:before-cache and next call modal#close add @winodws for the global element #}
<div {{ attributes.defaults({
    'data-controller':'modal',
    'data-action':'turbo:before-cache@window->modal#close'
}) }}
>
    {% block trigger %}{% endblock %}
    {# ASSIGN modal_controller.js property target #}
    <div class="relative z-10 hidden " aria-labelledby="modal-title" role="dialog" aria-modal="true" data-modal-target="dialog" data-action="close->modal#close">
      <div class="fixed inset-0 bg-transparent bg-opacity-80 backdrop-blur-sm transition-opacity" aria-hidden="true"></div>
            <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
                {% if modalWidth is not same as "" %}   
                    <div class="flex relative {{ fixedTop ? '' : 'min-h-full' }} items-end justify-center text-left sm:items-center sm:p-0   ">
                        <div class=" {{ modalWidth | raw }} m-4 p-4 modal:m-0 modal:p-0 bg-gray-800 rounded-lg text-white space-y-4 animate-fade-in" {{ closeButton }}>     
                {% endif %}
                    {% block content %}{% endblock %}
                 {% if  modalWidth is not same as "" %}   
                        </div>
                    </div>
                 {% endif %}
            </div>
            
    </div>
    {# LOADING CONTENT FOR MODAL DIALOG #}
    {%  if block('loading_template') %}
    <template data-modal-target="loadingContent">
       {% block loading_template %}{% endblock %}
    </template>
    {% endif %}
   
    {# END OF LOADING CONTENT FOR MODAL DIALOG #}
</div>
{# MODAL END #}