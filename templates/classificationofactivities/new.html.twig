{% set backPath=path('app_classificationofactivities_index') %}
{% extends 'modalBase.html.twig' %}
{% block title %}{{ parent() }} - New Client{% endblock %}
{% block body %}
{% set rawModalWidth = loadFrame.modalWidth | raw  %}
    {# ADD CLASS FOR tailwind.config.js  -> addVariant('modal','dialog &'); modal:m-0 and modal:p-0 #}
    <div class="{{ rawModalWidth == '' ? 'w-screen md:w-2/3 lg:w-2/4 xl:w-2/5 modal:m-0 modal:p-0' : rawModalWidth }} bg-gray-800 rounded-lg text-white space-y-4 m-4 p-4 ">
        <div class="flex justify-between">
            <h1 class="text-xl font-semibold text-white mb-4">Create New Classification of activities:</h1>
            <div class="mr-0">
                {# CLOSE ACTION - DEPENDS OF WINDOWS TYPE #}
                {{ loadFrame.closeAction | raw }}
                {# END CLOSE ACTION #}
            </div>
        </div>
        {{ include('classificationofactivities/_form.html.twig') }}
    </div>
{% endblock %}
{# ADD TURBO STREAM TO APPEND IN NEW ROW IN TABLE #}
{% block stream_success %}
    {# add `s` to target to use CSS selector #}
    <turbo-stream action="prepend" targets="#classificationofactivities-list tbody">
        <template>
             {% include('classificationofactivities/_row.html.twig') %}
        </template>
    </turbo-stream>
{% endblock %}