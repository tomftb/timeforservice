<tr class="even:bg-gray-700 odd:bg-gray-600" id="classificationofactivities-list-item-{{ classificationOfActivities.id }}">
    <td class="px-6 py-4 whitespace-nowrap">{{ classificationOfActivities.id }}</td>
    <td class="px-6 py-4">{{ classificationOfActivities.code }}</td>
    <td class="px-6 py-4">{{ classificationOfActivities.name }}</td>
    <td class="px-6 py-4">{{ classificationOfActivities.price }}</td>
    <td class="px-6 py-4">{{ classificationOfActivities.unit }}</td>
    <td class="px-6 py-4">{{ classificationOfActivities.updatedAt|date('Y-m-d H:i:s') }}</td>
    <td class="px-6 py-4">
        <a 
            href="{{ path('app_classificationofactivities_show', {'id': classificationOfActivities.id}) }}" 
            class="ml-4 text-blue-400 hover:text-blue-600"
            data-turbo-frame="modal"
        >show</a>
        <a 
            href="{{ path('app_classificationofactivities_edit', {'id': classificationOfActivities.id}) }}" 
            class="ml-4 text-yellow-400 hover:text-yellow-600"
            data-turbo-frame="modal"
        >edit</a>
        <a
            href="{{ path('app_classificationofactivities_delete', {'id': classificationOfActivities.id}) }}"
            class="block px-4 py-2 text-sm text-red-400 hover:text-red-600"
            data-turbo-frame="modal"
        >delete</a>
    </td>
</tr>