{% set backPath=path('app_classificationofactivities_index') %}
{% extends 'modalBase.html.twig' %}
{% block title %}{{ parent() }} - Edit Classification of activities - {{ classificationOfActivities.id }}{% endblock %}
{% block body %}
<div class=" w-1/3 modal:m-0 modal:p-0 bg-gray-800 rounded-lg text-white space-y-4 m-4 p-4">
    <div class="flex justify-between">
        <h1 class="text-xl font-semibold text-white mb-4">Edit Classification of activities:</h1>
        <div class="mr-0">
            {# CLOSE ACTION - DEPENDS OF WINDOWS TYPE #}
            {{ loadFrame.closeAction | raw }}
            {# END CLOSE ACTION #}
        </div>
    </div>
    {{ include('classificationofactivities/_form.html.twig') }}
</div>
{% endblock %}
{# ADD TURBO STREAM TO UPDATE ROW IN TABLE WITH CONTENT #}
{% block stream_success %}
    {# add `s` to target to use CSS selector #}
    <turbo-stream action="update" target="modal">
        <template>
        </template>
    </turbo-stream>
    <turbo-stream action="replace" target="classificationofactivities-list-item-{{ classificationOfActivities.id }}">
        <template>
            {% include('classificationofactivities/_row.html.twig') %}
        </template>
    </turbo-stream>
{% endblock %}